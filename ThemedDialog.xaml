<Window x:Class="DLSS5ManAger.ThemedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DLAssAss 5 Tool" Width="500" SizeToContent="Height" MaxHeight="620"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="Transparent"
        AllowsTransparency="True" KeyDown="Window_KeyDown">
    <Border Background="{StaticResource PanelBrush}" BorderBrush="#3A414D"
            BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="#11141A" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1" CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource TitleBarButton}"
                            Content="✕" ToolTip="Close" Click="Cancel_Click" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="13,0,0,0">
                        <Image Source="assets/icon_dark.png" Width="19" Height="19"
                               Stretch="Uniform" Margin="0,0,8,0" />
                        <TextBlock x:Name="TitleText" Foreground="White" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="22,22,22,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="IconBorder" Width="34" Height="34" CornerRadius="17"
                        BorderThickness="1" Background="#12161B" VerticalAlignment="Top">
                    <TextBlock x:Name="IconText" FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="MessageText" Foreground="#E7EAF0" FontSize="13"
                               TextWrapping="Wrap" LineHeight="19" />
                    <TextBox x:Name="InputTextBox" Visibility="Collapsed" Margin="0,16,0,0"
                             FontSize="13" MaxLength="120" />
                    <WrapPanel x:Name="ChoicePanel" Visibility="Collapsed" Margin="0,16,0,0" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Background="#14181E" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,8,8" Padding="18,13,10,5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="PrimaryButton" Content="OK" IsDefault="True"
                            MinWidth="84" Background="{StaticResource AccentBrush}"
                            BorderBrush="{StaticResource AccentBrush}" Foreground="#101216"
                            FontWeight="Bold" Click="Accept_Click" />
                    <Button x:Name="CancelButton" Content="CANCEL" IsCancel="True"
                            MinWidth="84" Visibility="Collapsed" Click="Cancel_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
